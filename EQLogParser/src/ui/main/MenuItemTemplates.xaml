<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="http://schemas.fontawesome.com/icons/">

    <!-- Custom template for MenuItems to ensure proper dropdown alignment -->
    <ControlTemplate x:Key="LeftAlignedMenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Border Name="MainBorder" 
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" MinWidth="24"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon content -->
                <ContentPresenter Grid.Column="0" 
                                Content="{TemplateBinding Icon}" 
                                ContentSource="Icon"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="4,0,6,0"/>
                
                <!-- Header content -->
                <ContentPresenter Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center"
                                Margin="2,1"/>
                
                <!-- Input gesture text -->
                <TextBlock Grid.Column="2"
                         Text="{TemplateBinding InputGestureText}"
                         Margin="5,1,5,1"
                         VerticalAlignment="Center"/>
                
                <!-- Submenu indicator -->
                <Path Grid.Column="3"
                    x:Name="SubMenuPopupArrow"
                    VerticalAlignment="Center"
                    Margin="5,0,5,0"
                    Fill="{TemplateBinding Foreground}"
                    Data="M0,0 L0,8 L4,4 Z"/>
                
                <!-- Popup for submenu items -->
                <Popup x:Name="PART_Popup"
                     AllowsTransparency="true"
                     Placement="Right"
                     HorizontalOffset="-3"
                     VerticalOffset="-3"
                     PlacementTarget="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type MenuItem}}}"
                     IsOpen="{TemplateBinding IsSubmenuOpen}"
                     Focusable="false">
                    <Border 
                        Background="{DynamicResource ContentBackground}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1">
                        <ScrollViewer Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Visibility" TargetName="SubMenuPopupArrow" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Visibility" TargetName="SubMenuPopupArrow" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Visibility" TargetName="SubMenuPopupArrow" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="true">
                <Setter Property="Background" TargetName="MainBorder" Value="{DynamicResource ContentBackgroundAlt4}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
