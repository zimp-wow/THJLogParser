<Window x:Class="EQLogParser.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="16" BorderBrush="#FF444B5D" BorderThickness="2" Padding="0" Background="#FF23272E">
        <Grid>
            <Image Source="pack://application:,,,/src/ui/main/splash.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Bottom" Margin="20" >
                <TextBlock x:Name="statusText" Text="Loading..." Foreground="White" FontSize="14" Margin="0,0,0,8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
