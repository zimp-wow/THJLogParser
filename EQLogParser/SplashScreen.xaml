<Window x:Class="EQLogParser.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="16" BorderBrush="#FF444B5D" BorderThickness="2" Padding="0" Background="#FF23272E">
        <Grid>
            <Image Source="splash.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
