<Window x:Class="EQLogParser.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="16" Background="#FF23272E" BorderBrush="#FF444B5D" BorderThickness="2" Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="src/ui/main/Logparsericon.ico" Width="64" Height="64" Margin="0,0,0,16"/>
            <TextBlock Text="THJ Log Parser" FontSize="28" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Loading..." FontSize="16" Foreground="#FFB0B6C3" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
